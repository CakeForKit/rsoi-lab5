{
  "realm": "rsoi",
  "enabled": true,
  "defaultDefaultClientScopes": ["profile", "email", "rsoi-username"],
  "clients": [
    {
      "clientId": "rsoi-gateway",
      "enabled": true,
      "publicClient": false,
      "secret": "rsoi-gateway-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "clientScopes": [
    {"name": "profile", "protocol": "openid-connect"},
    {"name": "email", "protocol": "openid-connect"},
    {
      "name": "rsoi-username",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "rsoi_username",
            "claim.name": "username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "testkate",
      "enabled": true,
      "firstName": "Test",
      "lastName": "Kate",
      "email": "testkate@example.com",
      "emailVerified": true,
      "requiredActions": [],
      "attributes": {"rsoi_username": ["Test Kate"]},
      "credentials": [{"type": "password", "value": "test", "temporary": false}]
    }
  ]
}
